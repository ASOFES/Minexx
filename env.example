# Configuration MINEXX — copier vers .env et renseigner les valeurs
SECRET_KEY=changez-moi-avec-une-cle-secrete-longue
DEBUG=True
DJANGO_SETTINGS_MODULE=gestion_vehicules.settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Base de données (laisser vide pour SQLite local)
# DATABASE_URL=postgres://user:pass@localhost:5432/minexx

# Superutilisateur créé au démarrage (start.sh) si défini
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=admin@minexx.com
# DJANGO_SUPERUSER_ROLE=admin

# Contrôles applicatifs sensibles
# ADMIN_CONTROL_PASSWORD=
# DEPARTEMENT_ACCESS_PASSWORD=

# Africa's Talking (SMS) — ne jamais committer la clé
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=

# Supabase (injection véhicules)
# SUPABASE_DB_HOST=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
